# Uploaded media only. Never execute anything in here.
Options -Indexes

<IfModule mod_mime.c>
  RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .phar .pht
  RemoveType .php .php3 .php4 .php5 .php7 .php8 .phtml .phar .pht
</IfModule>

<FilesMatch "\.(php|php[0-9]|phtml|phar|pht|phps|cgi|pl|py|asp|aspx|jsp|sh|htaccess)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
